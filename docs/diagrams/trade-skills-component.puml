@startuml Trade-Skill Inference Architecture
title Trade-Skill Inference (Stage 06)
skin rose
skinparam shadowing true
skinparam wrapWidth 200
skinparam maxMessageSize 80

package "CLI" {
  [CLI] as cli
}

package "Service" {
  [SkillService] as svc
}

package "Pipeline" {
  [Inference] as inf
  [Gate] as gate
}

package "LLM" {
  [Provider] as llm
}

package "DB" {
  [(permits)] as permits
  [(detail)] as details
  [(inferences)] as skills
}

package "Stage 05" {
  [DetailService] as detail_svc
}

' Main flow
cli --> svc
svc --> permits
svc --> detail_svc
detail_svc --> details
svc --> inf
inf --> llm
llm --> inf
inf --> gate
gate --> skills

' Context building (simplified)
svc .> inf : context

' State updates
svc .> permits : update state

note right of inf
  **Pipeline Steps:**
  1. Build context
  2. LLM call (temp=0.1)
  3. Validate schema
  4. Grounding gate
  5. Save
end note

@enduml