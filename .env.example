# Copy to .env (git-ignored) and fill in. Shell variables override this file.

# Database. Default: PostgreSQL in the Docker container (./script/pgvector.sh --start)
PERMIT_TRADE_SKILLS_DB_URL=postgresql://postgres:postgres@localhost:5432/permit_trade_skills

# LLM provider. false -> OpenAI (needs OPENAI_API_KEY); true -> local Ollama.
# Remove this line to use llm.use_local_ollama_model from config/settings.yaml.
PTS_USE_LOCAL_OLLAMA_MODEL=false
OPENAI_API_KEY=

# Optional: Hugging Face token for authenticated embedding-model downloads.
# HF_TOKEN=
